rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validPlacement(d) {
      return (
        d.stage == 'primary'
        && d.grade in [
          'الصف الأول الابتدائي','الصف الثاني الابتدائي','الصف الثالث الابتدائي',
          'الصف الرابع الابتدائي','الصف الخامس الابتدائي','الصف السادس الابتدائي'
        ] && d.department == '' && d.level == '' && d.get('departmentOther','') == ''
      ) || (
        d.stage == 'preparatory'
        && d.grade in ['الصف الأول الإعدادي','الصف الثاني الإعدادي','الصف الثالث الإعدادي']
        && d.department == '' && d.level == '' && d.get('departmentOther','') == ''
      ) || (
        d.stage == 'university' && d.grade == ''
        && d.department in ['english','english_translation','french','other']
        && d.level in ['المستوى الأول','المستوى الثاني','المستوى الثالث','المستوى الرابع','خريج جامعي']
        && (
          (d.department == 'other'
            && d.get('departmentOther','') is string
            && d.get('departmentOther','').size() >= 2
            && d.get('departmentOther','').size() <= 70)
          || (d.department != 'other' && d.get('departmentOther','') == '')
        )
      );
    }
    match /students/{uid} {
      allow get: if signedInOwner(uid);
      allow list: if false;
      allow create: if signedInOwner(uid)
        && request.resource.data.keys().hasAll([
          'uid','fullName','username','email','stage','grade','department','level','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid','fullName','username','email','stage','grade','department','level','departmentOther','createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 70
        && request.resource.data.username is string
        && request.resource.data.username.matches('^01[0125][0-9]{8}
        && request.resource.data.createdAt == request.time
        && validPlacement(request.resource.data);
      // Stage/department/grade cannot be changed by a student after registration.
      // Administrative changes require a trusted backend (not public client-side JS).
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
        && request.resource.data.createdAt == request.time
        && validPlacement(request.resource.data);
      // Stage/department/grade cannot be changed by a student after registration.
      // Administrative changes require a trusted backend (not public client-side JS).
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
